<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET"/>
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <queries><package android:name="com.killupdate.cleanmytv"/></queries>
    <application android:label="CleanMyTV Weather Helper" android:allowBackup="false" android:banner="@drawable/weather_banner" android:icon="@drawable/weather_banner"
        android:usesCleartextTraffic="false" android:theme="@android:style/Theme.Material.NoActionBar">
        <activity android:name=".WeatherActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <provider android:name=".WeatherProvider" android:authorities="com.killupdate.cleanmytv.weather.data"
            android:exported="true" android:grantUriPermissions="false"/>
    </application>
</manifest>
